Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_footprint
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
    - Class: rviz_default_plugins/Image
      Name: ArUco Image
      Enabled: true
      Topic:
        Value: /aruco/image
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Pose
      Name: ArUco Pose
      Enabled: true
      Shape: Axes
      Axes Length: 0.1
      Axes Radius: 0.01
      Topic:
        Value: /aruco/pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Width: 1100
  Height: 750
